+        z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+        return z ^ (z >> 31);
     }).iterator->value;
 }
 
+void Page::setBrowserFingerprintSeed(uint64_t seed)
+{
+    if (seed == m_browserFingerprintSeed)
+        return;
+    m_browserFingerprintSeed = seed;
+    m_noiseInjectionHashSalts.clear();
+}
