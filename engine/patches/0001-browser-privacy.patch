@@ -45,4 +47,21 @@ enum class AdvancedPrivacyProtections : uint16_t {
     OverrideHardwareConcurrency = 1 << 12,
 };
 
+// Browser: on for every page and every frame, whatever the embedder asked for.
+// There is no way to turn them off. EnhancedNetworkPrivacy (iCloud Private
+// Relay) is always off: Browser's traffic goes only where the system's
+// network, VPN included, sends it.
+inline OptionSet<AdvancedPrivacyProtections> browserProtections(OptionSet<AdvancedPrivacyProtections> requested)
+{
+    OptionSet<AdvancedPrivacyProtections> protections = requested | OptionSet<AdvancedPrivacyProtections> {
+        AdvancedPrivacyProtections::BaselineProtections,
+        AdvancedPrivacyProtections::FingerprintingProtections,
+        AdvancedPrivacyProtections::LinkDecorationFiltering,
+        AdvancedPrivacyProtections::ScriptTrackingPrivacy,
+        AdvancedPrivacyProtections::OverrideHardwareConcurrency,
+    };
+    protections.remove(AdvancedPrivacyProtections::EnhancedNetworkPrivacy);
+    return protections;
+}
+
 }
