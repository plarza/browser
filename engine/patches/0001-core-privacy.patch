+    return m_noiseInjectionHashSalts.ensure(domain, [&] {
+        if (!m_coreFingerprintSeed)
+            return cryptographicallyRandomNumber<uint64_t>();
+        // splitmix64 over the seed and the site: stable for this identity,
+        // unrelated across sites and across identities.
+        uint64_t z = m_coreFingerprintSeed ^ (static_cast<uint64_t>(domain.string().hash()) * 0x9E3779B97F4A7C15ull);
